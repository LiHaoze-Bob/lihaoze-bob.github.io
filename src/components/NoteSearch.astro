---
import { Icon } from 'astro-pure/user'
import { notes } from '../lib/content'
import { sections as noteSections } from '../lib/navigation.mjs'
import { href } from '../site.config'
import '../styles/search.css'

const titles = notes.map(({ url, title, subtitle }) => ({ url, title, subtitle }))
const sections = [
  { value: '', label: 'All' },
  ...noteSections.map(({ label }) => ({
    value: label, label
  }))
]
---
<note-search data-note-titles={JSON.stringify(titles)}>
  <div class='search-intro'>
    <h1>Search</h1>
  </div>
  <form class='search-form' role='search'>
    <label class='sr-only' for='search-input'>Search notes</label>
    <div class='search-box'>
      <Icon name='search' class='search-icon' />
      <input id='search-input' type='search' name='q' placeholder='Search notes…'
        autocomplete='off' spellcheck='false' enterkeyhint='search' aria-describedby='search-help' />
      <button type='button' class='search-clear' aria-label='Clear search' hidden><span aria-hidden='true'>×</span></button>
      <kbd class='search-shortcut' aria-hidden='true'>⌘ K</kbd>
    </div>
    <div class='search-filters' role='group' aria-label='Search categories'>
      {sections.map(section => <button type='button' data-section={section.value} aria-pressed={section.value === '' ? 'true' : 'false'}>
        {section.label}
      </button>)}
    </div>
  </form>
  <p id='search-help' class='sr-only'>Use arrow keys to select a result, Enter to open, and Escape to clear.</p>
  <div class='search-feedback'>
    <p class='search-status' role='status' aria-live='polite' aria-atomic='true'></p>
    <button type='button' class='search-retry' hidden>Retry</button>
  </div>
  <ul class='search-results' aria-label='Search results' hidden></ul>
  <button type='button' class='search-more' hidden>Load more</button>
  <noscript><p>Enable JavaScript to search, or <a href={href('/notes/')}>browse notes</a>.</p></noscript>
</note-search>
<script>
  import { setupSearch } from '../scripts/search'
  const root = document.querySelector<HTMLElement>('note-search')
  if (root) setupSearch(root)
</script>
