---
import { collectTags, notes } from '../lib/content'
import { href } from '../site.config'

interface Props { section: string }
const { section } = Astro.props
const sortedTags = collectTags(notes.filter(note => note.route.startsWith(`${section}/`)))
---
<section class='section-tags' aria-labelledby='section-tags-heading' data-pagefind-ignore>
  <h2 id='section-tags-heading'><i class='fa-solid fa-tags' aria-hidden='true'></i> Tags</h2>
  {sortedTags.length ? <ul>
    {sortedTags.map(tag => <li><a href={href(tag.url)} title={`${tag.count} ${tag.count === 1 ? 'note' : 'notes'} in this section`}>{tag.title}</a></li>)}
  </ul> : <p class='empty-tags'>No tags in this section.</p>}
  <a class='all-tags' href={href('/tags/')}>View all <span aria-hidden='true'>→</span></a>
</section>

<style>
  .section-tags { padding: .2rem 0 1rem; }
  h2 { display: flex; align-items: center; gap: .65rem; font-size: 1.1rem; font-weight: 600; margin: 0 0 1rem; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  li { min-width: 0; }
  li a { display: block; border: 1px solid var(--main-border-color); border-radius: .5rem; background: hsl(var(--muted)); padding: .15rem .5rem; font-size: .85rem; color: var(--text-muted-color); overflow-wrap: anywhere; text-decoration: none; transition: color .15s, border-color .15s; }
  li a:hover { color: var(--link-color); border-color: var(--link-color); }
  .all-tags { display: inline-block; margin-top: 1rem; font-size: .85rem; color: var(--text-muted-color); }
  .all-tags:hover { color: var(--link-color); }
  .empty-tags { font-size: .85rem; color: var(--text-muted-color); }
</style>
