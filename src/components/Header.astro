---
import config from 'virtual:config'
import { Icon } from 'astro-pure/user'
import { profile } from '../data/profile'
import { href } from '../site.config'
interface Props { lang?: 'en' | 'zh-CN' }
const path = Astro.url.pathname
---
<header-component class='site-header'>
  <a class='site-brand' href={href('/')} aria-label={`${profile.nickname} — Home`}>
    <img src={href(profile.avatar)} alt='' width='36' height='36' />
    <span>{profile.nickname}</span>
  </a>
  <nav id='headerExpandContent' class='site-nav' aria-label='Main navigation'>
    {config.header.menu.map(item => <a href={item.link} aria-current={path === item.link ? 'page' : undefined}>{item.title}</a>)}
  </nav>
  <div class='site-controls'>
    <a href={profile.github} rel='me' title='GitHub' aria-label='GitHub'><Icon name='github' /></a>
    <a href={href('/feed.xml')} title='Subscribe via RSS' aria-label='RSS feed'><Icon name='rss' /></a>
    <a class='header-search' href={href('/search/')} title='Search notes (⌘ / Ctrl + K)' aria-label='Search notes' aria-keyshortcuts='Meta+K Control+K'><Icon name='search' /></a>
    <button id='toggleDarkMode' type='button' aria-label='Change color theme'>
      <Icon class='system' name='computer' /><Icon class='light' name='sun' /><Icon class='dark-icon' name='moon' />
    </button>
    <button id='toggleMenu' class='site-menu-toggle' type='button' aria-label='Toggle navigation' aria-expanded='false' aria-controls='headerExpandContent'><Icon name='menu' /></button>
  </div>
</header-component>
<script is:inline>
  const themeControl = document.getElementById('toggleDarkMode')
  if (themeControl) {
    try { themeControl.dataset.theme = localStorage.getItem('theme') || 'system' }
    catch { themeControl.dataset.theme = 'system' }
  }
</script>
<script>
  import { setTheme } from 'astro-pure/utils'
  class HeaderComponent extends HTMLElement {
    private events?: AbortController
    connectedCallback() {
      this.events?.abort()
      this.events = new AbortController()
      const options = { signal: this.events.signal }
      this.dataset.enhanced = 'true'
      const menu = this.querySelector<HTMLButtonElement>('#toggleMenu')!
      const dark = this.querySelector<HTMLButtonElement>('#toggleDarkMode')!
      const closeMenu = () => { menu.setAttribute('aria-expanded', 'false'); this.removeAttribute('data-open') }
      dark.addEventListener('click', () => { dark.dataset.theme = setTheme(undefined, true) }, options)
      menu.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true'
        menu.setAttribute('aria-expanded', String(open))
        this.toggleAttribute('data-open', open)
      }, options)
      this.addEventListener('keydown', event => {
        if (event.key === 'Escape' && this.hasAttribute('data-open')) { closeMenu(); menu.focus() }
      }, options)
      window.matchMedia('(min-width: 640px)').addEventListener('change', () => closeMenu(), options)
      document.addEventListener('keydown', event => {
        if (!(event.metaKey || event.ctrlKey) || event.altKey || event.shiftKey || event.key.toLowerCase() !== 'k' || event.isComposing) return
        const target = event.target
        if (target instanceof HTMLElement && target.closest('input, textarea, select, [contenteditable="true"]') && target.id !== 'search-input') return
        event.preventDefault()
        const input = document.querySelector<HTMLInputElement>('#search-input')
        if (input) { input.focus(); input.select() }
        else window.location.assign(this.querySelector<HTMLAnchorElement>('.header-search')!.href)
      }, options)
    }
    disconnectedCallback() { this.events?.abort() }
  }
  if (!customElements.get('header-component')) customElements.define('header-component', HeaderComponent)
</script>
<style>
  .site-header { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.8rem; width: 100%; margin-bottom: 3.5rem; padding: .15rem 0; }
  .site-brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--text-color); font-family: var(--font-mono); font-size: 16px; font-weight: 500; white-space: nowrap; }
  .site-brand img { border-radius: 50%; width: 36px; height: 36px; object-fit: cover; }
  .site-nav { display: flex; align-items: center; gap: 1.5rem; margin-left: auto; font-family: var(--font-mono); font-size: 14px; font-weight: 400; }
  .site-nav a { color: var(--text-muted-color); text-decoration: none; }
  .site-nav a:hover, .site-nav a[aria-current] { color: var(--text-color); text-decoration: underline; text-underline-offset: .3em; }
  .site-controls { display: flex; align-items: center; gap: .65rem; }
  .site-controls > * { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 36px; color: var(--text-muted-color); border: 0; background: none; cursor: pointer; }
  .site-controls :global(svg) { width: 19px; height: 19px; }
  .site-controls .site-menu-toggle { display: none; }
  #toggleDarkMode :global(svg) { display: none; }
  #toggleDarkMode[data-theme='system'] :global(.system), #toggleDarkMode[data-theme='light'] :global(.light), #toggleDarkMode[data-theme='dark'] :global(.dark-icon) { display: block; }
  @media (max-width: 639px) {
    .site-header { gap: .8rem; margin-bottom: 2.5rem; }
    .site-controls { margin-left: auto; gap: .2rem; }
    .site-nav { order: 3; width: 100%; margin: 0; padding: .75rem 0 .25rem; gap: 1.5rem; }
    .site-header[data-enhanced] .site-menu-toggle { display: inline-flex; }
    .site-header[data-enhanced]:not([data-open]) .site-nav { display: none; }
  }
</style>
