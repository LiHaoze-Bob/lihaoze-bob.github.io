---
import { Button } from 'astro-pure/user'
import BaseLayout from '../layouts/BaseLayout.astro'
import { collectTags, notes } from '../lib/content'
import { href } from '../site.config'

const tags = collectTags(notes)
---
<BaseLayout meta={{ title: 'All Tags' }}>
  <Button title='Back' href={href('/')} variant='back' />
  <main class='tags-page' data-pagefind-body>
    <h1 data-pagefind-meta='title'>Tags</h1>
    {tags.length ? <ul class='tag-cloud' aria-label='All tags'>
      {tags.map(tag => <li>
        <a href={href(tag.url)} class:list={['tag-chip', { 'tag-medium': tag.count === 2, 'tag-large': tag.count >= 3 }]} aria-label={`${tag.title}, ${tag.count} ${tag.count === 1 ? 'note' : 'notes'}`}>
          <span>{tag.title}</span><span class='tag-count'>{tag.count}</span>
        </a>
      </li>)}
    </ul> : <p class='empty-tags'>No tags yet.</p>}
  </main>
</BaseLayout>

<style>
  .tags-page { margin-top: 2.5rem; margin-bottom: 3rem; }
  h1 { font-size: 1.875rem; line-height: 1.3; font-weight: 600; margin: 0 0 1.5rem; }
  .tag-cloud { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; list-style: none; padding: 0; margin: 0; }
  li { min-width: 0; max-width: 100%; }
  .tag-chip { display: inline-flex; align-items: baseline; gap: .25rem; max-width: 100%; padding: .25rem .5rem; border: 1px solid var(--main-border-color); border-radius: .5rem; background: hsl(var(--muted)); color: var(--text-muted-color); font-size: .875rem; line-height: 1.5; text-decoration: none; transition: background-color .15s, color .15s; }
  .tag-chip > :first-child { min-width: 0; overflow-wrap: anywhere; }
  .tag-chip:hover { background: hsl(var(--card)); color: var(--text-color); }
  .tag-count { flex-shrink: 0; font-size: .75rem; }
  .tag-medium { font-size: 1.125rem; }
  .tag-large { font-size: 1.25rem; padding-inline: .75rem; }
  .tag-large .tag-count { font-size: 1rem; }
  .empty-tags { color: var(--text-muted-color); }
  @media (max-width: 640px) { .tag-cloud { gap: .75rem; } }
</style>
